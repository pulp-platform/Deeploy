   } else {
-    Cost = divideCeil(VT.getSizeInBits(), Subtarget.getRealMinVLen() / DLenFactor);
+    unsigned DLen = Subtarget.getRealMinVLen() / DLenFactor;
+    // Without any V extension getRealMinVLen() is 0. Return a neutral cost
